# Copy to .env for local runs (node --env-file=.env server.js). On Railway, set these under Variables.

# Required in production: long random string (>= 32 chars). Signs session cookies and encrypts the saved API key.
SESSION_SECRET=
# Optional: first administrator, created on first start if it doesn't exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to true once to reset ADMIN_USERNAME's password to ADMIN_PASSWORD, then remove it.
# ADMIN_PASSWORD_RESET=true

# Optional: separate secret for encrypting the API key (defaults to SESSION_SECRET).
# ENCRYPTION_KEY=
# Optional: fallback key if none is saved in Settings.
# ANTHROPIC_API_KEY=
# Where users/settings are stored. Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically when a volume is attached.
# DATA_DIR=./data
# SESSION_HOURS=12
# AI_REQUESTS_PER_HOUR=30
# AI_MAX_TOKENS=4000
